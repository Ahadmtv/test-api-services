# برنامه رزرو خدمات — متغیرهای محیطی توسعه‌دهنده (نمونه)
# کپی این فایل به .env و مقادیر را با مقادیر محلی تغییر دهید.
# هرگز فایل .env حاوی راز واقعی را در مخزن ثبت نکنید.

APP_ENV=development
APP_VERSION=0.2.0

# احراز هویت (مرحله ۰۲)
AUTH_ACCESS_TOKEN_SECRET=01234567890123456789012345678901
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
AUTH_RATE_LIMIT_PER_MIN=30

# دسترس‌پذیری (مرحله 04): گام شروع اسلات، حداقل مهلت و افق از لحظه اکنون
AVAILABILITY_SLOT_INCREMENT=15m
AVAILABILITY_MIN_NOTICE=2h
AVAILABILITY_MAX_HORIZON=2160h

# چرخه رزرو (مرحله 05)
BOOKING_CANCELLATION_CUTOFF=0s

# تکمیل و اختلاف (مرحله 08): پنجره اختلاف مشتری پس از درخواست تکمیل
BOOKING_COMPLETION_DISPUTE_WINDOW=72h

# تسویه ارائه‌دهنده (مرحله 08): کمینه مبلغ (ریال) برای درخواست تسویه
PAYOUT_MIN_AMOUNT_IRR=100000

# پرداخت (مرحله 07): در sandbox نبود ZARINPAL_MERCHANT_ID با یک UUID غیرراز ثابت
# جبران می‌شود؛ در production این مقدار الزامی است. هرگز merchant واقعی را در مخزن ثبت نکنید.
PAYMENT_ENVIRONMENT=sandbox
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=http://localhost:8080/api/v1/payments/zarinpal/callback

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=30s

DB_HOST=localhost
DB_PORT=5432
DB_USER=booker
DB_PASSWORD=changeme
DB_NAME=bookings
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_CONN_IDLE_TIME=10m
DB_MAX_CONN_LIFETIME=1h

LOG_LEVEL=debug
LOG_FORMAT=text
