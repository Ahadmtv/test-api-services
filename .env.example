# برنامه رزرو خدمات — متغیرهای محیطی توسعه‌دهنده (نمونه)
# کپی این فایل به .env و مقادیر را با مقادیر محلی تغییر دهید.
# هرگز فایل .env حاوی راز واقعی را در مخزن ثبت نکنید.

APP_ENV=development
APP_VERSION=0.2.0

# احراز هویت (مرحله ۰۲)
AUTH_ACCESS_TOKEN_SECRET=01234567890123456789012345678901
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
AUTH_RATE_LIMIT_PER_MIN=30

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=30s

DB_HOST=localhost
DB_PORT=5432
DB_USER=booker
DB_PASSWORD=changeme
DB_NAME=bookings
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_CONN_IDLE_TIME=10m
DB_MAX_CONN_LIFETIME=1h

LOG_LEVEL=debug
LOG_FORMAT=text
